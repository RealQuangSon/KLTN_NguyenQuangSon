# Root env template: export these variables explicitly; backend does not load .env.
# Offline/local defaults. No API key or paid services needed.
HOMEMATCH_PUBLIC=false
HOMEMATCH_AUTH_MODE=seed
HOMEMATCH_TOKEN_TTL_SECONDS=3600
HOMEMATCH_LLM_MODE=demo
HOMEMATCH_DB_PATH=.local/homematch.sqlite
HOMEMATCH_DATABASE_URL=
# For the isolated local PG cluster, use:
# HOMEMATCH_DATABASE_URL=postgresql://homematch@127.0.0.1:55432/homematch_dev
# Used only when the stored catalog is empty. Import is an explicit CLI action.
HOMEMATCH_CATALOG_PATH=data/catalog/rooms.json
HOMEMATCH_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
HOMEMATCH_MATCHING_METHOD=B1
# Auto-publish (demo local): phòng qua bộ lọc được công bố NGAY cho người thuê,
# không chờ ai duyệt; quyết định tự động vẫn ghi sổ duyệt với lý do ghi rõ để
# chủ nhà đối chiếu sau. Mặc định BẬT (bỏ biến này cũng là bật); đặt false để
# quay lại luồng chủ nhà duyệt từng căn trước khi người thuê thấy.
HOMEMATCH_AUTO_PUBLISH=true
# Tần suất vòng lặp công việc nền (giây): sinh gợi ý, nhắc lịch, nhắc thanh toán...
# Demo set 10-30 để kết quả hiện nhanh; môi trường thật để 300.
HOMEMATCH_JOBS_INTERVAL_SECONDS=300
HOMEMATCH_EMBEDDING_MODE=disabled
HOMEMATCH_EMBEDDING_MODEL=text-embedding-3-small
HOMEMATCH_EMBEDDING_DIMENSIONS=1536
HOMEMATCH_SEMANTIC_ALPHA=0.3
HOMEMATCH_CONTEXT_TOKEN_CAP=4000
OPENAI_MODEL=gpt-4o-2024-08-06
# Configure only on the backend when deliberately using live providers.
OPENAI_API_KEY=
# Optional OpenRouter (or any OpenAI-compatible gateway exposing /chat/completions):
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# HOMEMATCH_LLM_API=chat_completions
# OPENAI_MODEL=openai/gpt-6-luna
# (OpenRouter serves no /embeddings endpoint, so keep HOMEMATCH_EMBEDDING_MODE=disabled there.)
LANGGRAPH_STRICT_MSGPACK=true
# Optional seed overrides for the four trial accounts (renter, owner1, owner2,
# admin; default password 123456). Public mode requires all four strong
# non-default passwords (at least 16 chars) matching stored hashes.
HOMEMATCH_PASSWORD_RENTER=
HOMEMATCH_PASSWORD_OWNER1=
HOMEMATCH_PASSWORD_OWNER2=
HOMEMATCH_PASSWORD_ADMIN=
# Chợ Tốt demo catalog store (data/crawl_chotot.py --push-only|--pull|--list). Online Postgres; never commit it.
# HOMEMATCH_CRAWL_DATABASE_URL=
# Key Goong loại "Map tiles" (riêng với key REST API) để nạp tile bản đồ ở
# frontend (VITE_GOONG_API_KEY trong frontend/.env.local). Key REST dùng cho
# geocoding/directions là loại khác. Sai loại key -> tile trả 403 và frontend
# tự fallback OpenStreetMap. Lấy key tại goong.io -> API keys.
# Backend dùng GOONG_API_KEY (loại REST) cho chỉ đường xe máy; key tile bị
# Direction trả 403 thì backend chuyển sang OSRM công khai.
GOONG_API_KEY=
# MP-01 chỉ đường căn -> điểm neo: auto|goong|osrm|off (off = chỉ đường chim bay).
# HOMEMATCH_ROUTE_PROVIDER=auto
# LOC-001 tra địa danh ngoài danh mục cho find_place: auto|nominatim|goong|off (off = chỉ danh mục).
# Chỉ gửi tên địa danh đã bỏ PII + thành phố; không gửi số nhà, id phiên hay tọa độ.
# HOMEMATCH_GEOCODER=auto
# HOMEMATCH_OSRM_URL=https://routing.openstreetmap.de

# AG-11: quyết định hỏi lại khi mơ hồ — jev (OpenRouter Decisions API, tốn phí
# nhỏ) hoặc rules (luật trên số căn, offline). Jev lỗi → tự fallback rules.
# HOMEMATCH_DECISION_MODE=rules
# HOMEMATCH_DECISION_MODEL=typesafe/jev-1.14

# HN-13 multi-agent: analyst phân tích đầu vào (route+clarity) trước khi định
# tuyến sang agent chuyên trách — jev | rules (mặc định) | off (giữ hành vi một
# vòng lặp cũ). jev lỗi/timeout/breaker mở → luật dự phòng, không chặn lượt.
# HOMEMATCH_INPUT_ANALYST=rules
