# Root env template: export these variables explicitly; backend does not load .env.
# Offline/local defaults. No API key or paid services needed.
HOMEMATCH_PUBLIC=false
HOMEMATCH_AUTH_MODE=seed
HOMEMATCH_TOKEN_TTL_SECONDS=3600
HOMEMATCH_LLM_MODE=demo
HOMEMATCH_DB_PATH=.local/homematch.sqlite
HOMEMATCH_DATABASE_URL=
# For the isolated local PG cluster, use:
# HOMEMATCH_DATABASE_URL=postgresql://homematch@127.0.0.1:55432/homematch_dev
# Used only when the stored catalog is empty. Import is an explicit CLI action.
HOMEMATCH_CATALOG_PATH=data/catalog/rooms.json
HOMEMATCH_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
HOMEMATCH_MATCHING_METHOD=B1
HOMEMATCH_EMBEDDING_MODE=disabled
HOMEMATCH_EMBEDDING_MODEL=text-embedding-3-small
HOMEMATCH_EMBEDDING_DIMENSIONS=1536
HOMEMATCH_SEMANTIC_ALPHA=0.3
HOMEMATCH_CONTEXT_TOKEN_CAP=4000
OPENAI_MODEL=gpt-4o-2024-08-06
# Configure only on the backend when deliberately using live providers.
OPENAI_API_KEY=
LANGGRAPH_STRICT_MSGPACK=true
# Optional local seed overrides. Public mode requires all four strong non-default
# passwords (at least 16 chars) matching stored hashes; rotate explicitly first.
HOMEMATCH_PASSWORD_RENTER_A=
HOMEMATCH_PASSWORD_RENTER_B=
HOMEMATCH_PASSWORD_MANAGER_A=
HOMEMATCH_PASSWORD_MANAGER_B=
